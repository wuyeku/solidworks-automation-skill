    "solidworks_mass_properties": {
      "name": "solidworks_mass_properties",
      "title": "Read Mass Properties",
      "description": "Read mass, volume, surface area, centre of mass, and inertia of the active document.\n\nIf the document has no material assigned, SolidWorks falls back to its default density,\nso the reported mass is flagged as unreliable rather than silently returned as fact.\n",
      "inputSchema": {
        "$defs": {
          "ResponseFormat": {
            "description": "Tool response format.",
            "enum": [
              "json",
              "markdown"
            ],
