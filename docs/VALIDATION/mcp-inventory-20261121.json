            "additionalProperties": false,
            "description": "Input for reading mass properties of the active document.",
            "properties": {
              "density_kg_m3": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "maximum": 30000.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Override material density. Omit to use the material assigned in the document.",
