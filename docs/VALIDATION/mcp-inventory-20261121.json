    "solidworks_connect": {
      "name": "solidworks_connect",
      "title": "Connect to SolidWorks",
      "description": "Connect to a running SolidWorks instance or start one; return the SolidWorks version (revision) and active document status.",
      "inputSchema": {
        "$defs": {
          "ResponseFormat": {
            "description": "Tool response format.",
            "enum": [
              "json",
              "markdown"
            ],
            "title": "ResponseFormat",
            "type": "string"
          },
          "SolidWorksConnectInput": {
            "additionalProperties": false,
            "description": "Input for connecting to SolidWorks.",
            "properties": {
              "visible": {
                "default": true,
                "description": "Whether a newly started SolidWorks instance should be visible.",
                "title": "Visible",
                "type": "boolean"
              },
              "wait_seconds": {
                "default": 5,
                "description": "Seconds to wait after starting SolidWorks.",
                "maximum": 60,
                "minimum": 0,
                "title": "Wait Seconds",
                "type": "integer"
              },
              "version": {
                "anyOf": [
                  {
                    "maximum": 2035,
                    "minimum": 2010,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional target SolidWorks year; reject a different connected version.",
                "title": "Version"
              },
              "response_format": {
                "$ref": "#/$defs/ResponseFormat",
                "default": "json",
                "description": "Return format."
              }
            },
            "title": "SolidWorksConnectInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/SolidWorksConnectInput",
            "default": {
              "visible": true,
              "wait_seconds": 5,
              "version": null,
              "response_format": "json"
            }
          }
        },
        "title": "solidworks_connectArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "solidworks_connectOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "effect": "write",
      "approval_required": false,
      "approval_mode": "task",
      "policy_note": "可能启动新的 SolidWorks 进程。",
      "available": true
    },
